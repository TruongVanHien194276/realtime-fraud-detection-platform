FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV SPARK_LOCAL_DIRS=/workspace/data/tmp/spark

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       openjdk-17-jre-headless \
       curl \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    pyspark==3.5.7 \
    pytest==9.1.1

# Runtime JAR đúng cặp Spark 3.5 + Scala 2.12.
RUN mkdir -p /opt/iceberg \
    && curl -fSL \
       https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.10.1/iceberg-spark-runtime-3.5_2.12-1.10.1.jar \
       -o /opt/iceberg/iceberg-spark-runtime.jar

CMD ["bash"]

RUN mkdir -p /opt/jdbc \
    && curl -fSL \
       https://repo.maven.apache.org/maven2/org/postgresql/postgresql/42.7.7/postgresql-42.7.7.jar \
       -o /opt/jdbc/postgresql.jar