.DS_Store
.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.log

# Datasets and generated lakehouse tables
data/raw/*
data/samples/*
data/tmp/
data/bronze/*
data/silver/*
data/gold/*
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/samples/.gitkeep
!data/samples/sample_manifest.json

# Runtime state
checkpoints/
artifacts/
mlruns/
logs/
tmp/

# BI and local secrets
*.pbix
*.pbit
*.duckdb
*.db
*.sqlite

data/lakehouse/

# Generated dbt state; models and tests under dbt/ remain versioned.
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
