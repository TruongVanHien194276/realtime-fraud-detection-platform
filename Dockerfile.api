FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /workspace

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir \
    -e ".[dev]" \
    pandas==2.3.3 \
    scikit-learn==1.8.0 \
    mlflow==3.16.1 \
    fastapi==0.119.0 \
    "uvicorn[standard]==0.38.0" \
    redis==6.4.0 \
    httpx==0.28.1 \
    prometheus-client==0.23.1

CMD ["uvicorn", "fraud_platform.scoring_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
