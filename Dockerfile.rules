FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN python -m pip install --no-cache-dir \
    confluent-kafka==2.11.1 \
    "psycopg[binary]==3.2.6" \
    redis==5.2.1 \
    PyYAML==6.0.2 \
    pydantic==2.14.1 \
    pytest==9.1.1

CMD ["python", "--version"]